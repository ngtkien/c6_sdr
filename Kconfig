mainmenu "c6_sdr — ESP32-P4 driving c6_sdr hybrid slave firmware"

config C6_SDR_SWEEP_LO_MHZ
	int "Sweep start frequency (MHz)"
	default 2400

config C6_SDR_SWEEP_HI_MHZ
	int "Sweep end frequency (MHz)"
	default 2500

config C6_SDR_SWEEP_STEP_MHZ
	int "Sweep step (MHz)"
	default 20

config C6_SDR_SPEC_MS
	int "Per-point SPEC run duration (ms)"
	default 300
	help
	  Bounded ring-capture run per frequency point; frames are pulled
	  after each run completes. Keep staged bytes (~frames x 270 B)
	  under the slave's 32 KiB sink or the ring overflows. Longer
	  runs amortize RPC overhead → faster waterfall scroll.

config C6_SDR_RUNS
	int "Number of sweep repetitions (0 = forever)"
	default 0
	help
	  0 keeps sweeping indefinitely — the usual choice when the DSI
	  waterfall is the live display.

config C6_SDR_NFFT
	int "FFT size (power of two)"
	default 256

config C6_SDR_STRIDE
	int "FFT stride (process every Nth unit block)"
	default 1
	help
	  1 = every captured unit produces an FFT (max frame rate).

config C6_SDR_UNITS_PER_FRAME
	int "Units merged per emitted frame"
	default 2
	help
	  Smaller values emit more, thinner frames — faster waterfall
	  scroll at lower per-row integration.

config C6_SDR_MAX_HOLD
	bool "Per-bin max-hold instead of mean power"
	default n

config C6_SDR_GAIN
	int "RX gain code (0..54, 255=HW AGC, 256=keep)"
	default 255

config C6_SDR_DCAP
	int "Analog filter code (0..63, 254=auto, 255=keep)"
	default 254

config C6_SDR_DSI
	bool "Render waterfall on the DSI panel"
	default y

config C6_SDR_ASCII_WF
	bool "ASCII waterfall rows on the serial console"
	default y if !C6_SDR_DSI
	help
	  The 96-column text waterfall is heavy on a 115200 UART; leave it
	  off when the DSI panel carries the display. Sweep summaries and
	  errors are always printed.

config C6_SDR_SD_DUMP
	bool "Append captures to files on the SD card"
	default y

config C6_SDR_IQ_BURST
	bool "Run a single-shot raw-I/Q burst after the sweep"
	default y

config C6_SDR_IQ_FREQ_MHZ
	int "I/Q burst center frequency (MHz)"
	default 2440

source "Kconfig.zephyr"
